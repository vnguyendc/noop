# Copy to Config/TestFlight.env (git-ignored) for Tools/testflight.py.
# Create the key in App Store Connect > Users and Access > Integrations > App Store Connect API
# (Admin access), and download the .p8 file. Keep it outside the repo; never paste its contents.

ASC_KEY_ID=ABCDE12345
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Optional; this is the default:
# ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_ABCDE12345.p8
